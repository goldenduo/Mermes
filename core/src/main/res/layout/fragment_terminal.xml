<?xml version="1.0" encoding="utf-8"?>
<!--
    Terminal Fragment Layout
    Extra keys layout strictly follows Termux DEFAULT_IVALUE_EXTRA_KEYS:
    Row 1: [ESC]  [/]  [-]  [HOME]  [UP]    [END]   [PGUP]
    Row 2: [TAB]  [CTRL] [ALT] [LEFT]  [DOWN]  [RIGHT] [PGDN]
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Session Tab Bar -->
    <HorizontalScrollView
        android:id="@+id/sessionTabScroll"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#FF1A1A1A"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/sessionTabLayout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

    </HorizontalScrollView>

    <!-- Terminal View -->
    <com.mermes.core.terminal.view.TerminalView
        android:id="@+id/terminalView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FF000000" />

    <!-- Extra Keys Scroll (Double Row — Termux DEFAULT_IVALUE_EXTRA_KEYS) -->
    <HorizontalScrollView
        android:id="@+id/extraKeysScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF1E1E1E"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/extraKeysLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <!--
                Row 1: ESC  /  -  HOME  UP  END  PGUP
                Matches: ['ESC','/',{key: '-', popup: '|'},'HOME','UP','END','PGUP']
            -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="3dp">

                <!-- ESC -->
                <Button
                    android:id="@+id/btnEsc"
                    style="@style/Widget.AppCompat.Button.Small"
                    android:layout_width="50dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:background="#FF2D2D2D"
                    android:text="@string/key_esc"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:padding="0dp"
                    android:textAllCaps="true" />

                <!-- / -->
                <Button
                    android:id="@+id/btnSlash"
                    android:layout_width="36dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:background="#FF2D2D2D"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="/"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />

                <!-- - (long press for |) -->
                <Button
                    android:id="@+id/btnMinus"
                    android:layout_width="36dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:background="#FF2D2D2D"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="-"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />

                <!-- | (popup key from '-', shown as separate button) -->
                <Button
                    android:id="@+id/btnPipe"
                    android:layout_width="36dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:background="#FF3A3A3A"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="|"
                    android:textColor="#FFAAAAAA"
                    android:textSize="15sp" />

                <!-- HOME -->
                <Button
                    android:id="@+id/btnHome"
                    style="@style/Widget.AppCompat.Button.Small"
                    android:layout_width="56dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:background="#FF2D2D2D"
                    android:text="@string/key_home"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:padding="0dp"
                    android:textAllCaps="true" />

                <!-- UP -->
                <Button
                    android:id="@+id/btnUp"
                    android:layout_width="36dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:background="#FF2D2D2D"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="↑"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />

                <!-- END -->
                <Button
                    android:id="@+id/btnEnd"
                    style="@style/Widget.AppCompat.Button.Small"
                    android:layout_width="50dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:background="#FF2D2D2D"
                    android:text="@string/key_end"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:padding="0dp"
                    android:textAllCaps="true" />

                <!-- PGUP -->
                <Button
                    android:id="@+id/btnPgUp"
                    style="@style/Widget.AppCompat.Button.Small"
                    android:layout_width="56dp"
                    android:layout_height="32dp"
                    android:background="#FF2D2D2D"
                    android:text="@string/key_pgup"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:padding="0dp"
                    android:textAllCaps="true" />

            </LinearLayout>

            <!--
                Row 2: TAB  CTRL  ALT  LEFT  DOWN  RIGHT  PGDN
                Matches: ['TAB','CTRL','ALT','LEFT','DOWN','RIGHT','PGDN']
            -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- TAB -->
                <Button
                    android:id="@+id/btnTab"
                    style="@style/Widget.AppCompat.Button.Small"
                    android:layout_width="50dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:background="#FF2D2D2D"
                    android:text="@string/key_tab"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:padding="0dp"
                    android:textAllCaps="true" />

                <!-- CTRL (ToggleButton — tri-state modifier) -->
                <ToggleButton
                    android:id="@+id/btnCtrl"
                    android:layout_width="56dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:background="#FF2D2D2D"
                    android:text="@string/key_ctrl"
                    android:textOff="@string/key_ctrl"
                    android:textOn="@string/key_ctrl"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:padding="0dp"
                    android:textAllCaps="true" />

                <!-- ALT (ToggleButton — tri-state modifier) -->
                <ToggleButton
                    android:id="@+id/btnAlt"
                    android:layout_width="50dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:background="#FF2D2D2D"
                    android:text="@string/key_alt"
                    android:textOff="@string/key_alt"
                    android:textOn="@string/key_alt"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:padding="0dp"
                    android:textAllCaps="true" />

                <!-- LEFT -->
                <Button
                    android:id="@+id/btnLeft"
                    android:layout_width="36dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:background="#FF2D2D2D"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="←"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />

                <!-- DOWN -->
                <Button
                    android:id="@+id/btnDown"
                    android:layout_width="36dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:background="#FF2D2D2D"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="↓"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />

                <!-- RIGHT -->
                <Button
                    android:id="@+id/btnRight"
                    android:layout_width="36dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:background="#FF2D2D2D"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="→"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />

                <!-- PGDN -->
                <Button
                    android:id="@+id/btnPgDn"
                    style="@style/Widget.AppCompat.Button.Small"
                    android:layout_width="56dp"
                    android:layout_height="32dp"
                    android:background="#FF2D2D2D"
                    android:text="@string/key_pgdn"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:padding="0dp"
                    android:textAllCaps="true" />

            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
