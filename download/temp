# 下载并安装 nvm：
curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash
# 代替重启 shell
\. "$HOME/.nvm/nvm.sh"
# 下载并安装 Node.js：
nvm install 22
# 验证 Node.js 版本：
node -v # Should print "v22.22.3".
# 验证 npm 版本：
npm -v # Should print "10.9.8".




