    <!-- Secure Encryption -->
    <string name="ssh_secure_card_title">Secure Credential Encryption</string>
    <string name="ssh_secure_encryption_enable">Enable Android KeyStore Encryption</string>
    <string name="ssh_secure_encryption_desc">Enabled by default. Generates a private symmetric key inside the Android system-level hardware secure keystore (AES-GCM) to strongly encrypt your saved passwords and key passphrases. Prevents credentials from being dumped or inspected by other malicious applications on rooted or vulnerable devices.</string>

    <!-- SSH Port Forwarding Tunnel -->
