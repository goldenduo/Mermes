    <string name="ssh_tunnel_enable">Enable Local Port Forwarding</string>
    <string name="ssh_tunnel_local_port">Local Listening Port</string>
    <string name="ssh_tunnel_remote_host">Remote Forward Host</string>
    <string name="ssh_tunnel_remote_port">Remote Forward Port</string>
    <string name="ssh_tunnel_desc">When enabled, an encrypted local port forwarding tunnel is automatically opened along with the SSH connection. For example, it maps local port 11434 to remote server\'s 127.0.0.1:11434. This allows local AI services or chat clients to securely communicate with remote LLM engines (such as Ollama or Claw3D).</string>

