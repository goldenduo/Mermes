<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="500dp"
    android:background="#161720"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Title Bar -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💬 Mermes 智能对话终端"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Chat Logs scrollable area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:background="#1A1B24"
        android:padding="12dp">

        <TextView
            android:id="@+id/chatLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E0E2EC"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:text="🤖 Mermes: 欢迎开启智能控制台！我正在后台监听本地和 SSH 网关连接，请在下方发送指令…" />

    </ScrollView>

    <!-- Chat Input Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/editInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="向 Agent 提问或发射指令…"
            android:textColor="#FFFFFF"
            android:textColorHint="#5E6278"
            android:textSize="14sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发送"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB"
            android:layout_marginStart="10dp" />

    </LinearLayout>

</LinearLayout>
