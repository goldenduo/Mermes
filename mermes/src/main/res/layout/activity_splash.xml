<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F13"
    android:padding="24dp">

    <!-- Top Glow Effect (Decorative) -->
    <View
        android:id="@+id/topGlow"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/glow_gradient"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="-150dp" />

    <!-- Center Content -->
    <LinearLayout
        android:id="@+id/centerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/errorCard"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <!-- Mermes Title with sleek HSL tailored style -->
        <TextView
            android:id="@+id/logoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MERMES"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INTELLIGENT AGENT CONSOLE"
            android:textColor="#60647C"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:layout_marginTop="6dp" />

        <!-- Progress Indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="220dp"
            android:layout_height="6dp"
            android:layout_marginTop="48dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_custom" />

        <!-- Status Text -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/splash_installing"
            android:textColor="#E0E2EC"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Error & Retry Card (Hidden by default, shown when retry occurs or failure is reached) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/errorCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:visibility="gone"
        app:cardBackgroundColor="#1A1B24"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#2F3142"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/errorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="部署异常提示"
                android:textColor="#FF6B7C"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/errorDetailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#AFB2C2"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"
                tools:text="正在重试 1/3... 异常原因" />

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:gravity="end">

                <Button
                    android:id="@+id/btnExit"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_exit"
                    android:textColor="#9094A6" />

                <Button
                    android:id="@+id/btnRetry"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_retry"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="12dp"
                    app:strokeColor="#4A4F6B"
                    app:rippleColor="#20FFFFFF"/>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
