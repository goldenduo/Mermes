<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 存储权限 (用于 SSH 密钥导入) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- 相机权限 (用于附件拍照) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 前台服务权限 (用于 SSH 隧道保活) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".MermesApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mermes"
        tools:targetApi="31">

        <!-- 主 Activity (Single Activity Architecture) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Mermes.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SSH 隧道前台服务 -->
        <service
            android:name=".service.SshTunnelService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />

        <!-- Bootstrap 解包前台服务 -->
        <service
            android:name=".service.BootstrapService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />

    </application>

</manifest>
